{
	"name": "pl_ingest_inmet_landing_dev_estacao",
	"properties": {
		"activities": [
			{
				"name": "set_year_list",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "year_list",
					"value": {
						"value": "@range(pipeline().parameters.start_year, add(sub(pipeline().parameters.end_year,pipeline().parameters.start_year),1))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "foreach_ano",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "set_year_list",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('year_list')",
						"type": "Expression"
					},
					"batchCount": 5,
					"activities": [
						{
							"name": "copy_inmet_to_landing",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 60,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "GoogleBigQueryV2Source",
									"query": {
										"value": "@concat('SELECT * FROM `basedosdados.br_inmet_bdmep.microdados`\nWHERE id_estacao = ''',pipeline().parameters.id_estacao,'''\nAND ano = ',string(item()))",
										"type": "Expression"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": false,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_bigquey_inmet_src_dev",
									"type": "DatasetReference",
									"parameters": {
										"id_estacao": {
											"value": "@pipeline().parameters.id_estacao",
											"type": "Expression"
										},
										"ano": {
											"value": "@item()",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_parquet_inmet_landing_dev",
									"type": "DatasetReference",
									"parameters": {
										"ano": {
											"value": "@item()",
											"type": "Expression"
										},
										"file_name": {
											"value": "@toLower(concat('atmos_', pipeline().parameters.id_estacao, '_', string(item()),'_',formatDateTime(utcNow(), 'yyyyMMddHHmmss'), '.parquet'))",
											"type": "Expression"
										},
										"id_estacao": {
											"value": "@pipeline().parameters.id_estacao",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"id_estacao": {
				"type": "string"
			},
			"start_year": {
				"type": "int"
			},
			"end_year": {
				"type": "int"
			}
		},
		"variables": {
			"year_list": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "INMET"
		},
		"annotations": []
	}
}